{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HEYI upstream upgrade intent (not a qualified stack lock)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "upstream_url", "refs", "target_commit", "platforms", "mandatory_features", "checks", "check_timeout_seconds", "comparison_limits"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"},
    "upstream_url": {"const": "https://github.com/ai-dynamo/dynamo.git"},
    "refs": {
      "type": "object", "additionalProperties": false, "required": ["base", "heyi", "target"],
      "properties": {
        "base": {"type": "string", "minLength": 1},
        "heyi": {"type": "string", "minLength": 1},
        "target": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "target_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "platforms": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["architecture", "vllm", "repository", "image", "python", "sources"],
        "properties": {
          "architecture": {"enum": ["amd64", "arm64"]},
          "vllm": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "repository": {"type": "string", "minLength": 3},
          "image": {"type": "string", "minLength": 3},
          "python": {"type": "string", "pattern": "^(python[0-9.]*|/[^\\s]+)$"},
          "plugin": {"type": "string", "minLength": 1},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}}
        }
      }
    },
    "mandatory_features": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^M[0-9]{2}-F[0-9]{2}$"}},
    "deferred_features": {
      "type": "object",
      "propertyNames": {"pattern": "^M[0-9]{2}-F[0-9]{2}$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["disposition", "reason", "accepted_by", "reference"],
        "properties": {
          "disposition": {"const": "deferred"},
          "reason": {"type": "string", "pattern": "\\S"},
          "accepted_by": {"type": "string", "pattern": "\\S"},
          "reference": {"type": "string", "pattern": "\\S"}
        }
      }
    },
    "checks": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
    "check_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "comparison_limits": {
      "type": "object", "additionalProperties": false, "required": ["min_throughput_ratio", "max_latency_ratio"],
      "properties": {
        "min_throughput_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_latency_ratio": {"type": "number", "minimum": 1}
      }
    }
  }
}
