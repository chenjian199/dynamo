{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "issues"
  ],
  "properties": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "platform",
          "feature_id",
          "status",
          "reason"
        ]
      }
    }
  }
}
