{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "feature_id",
          "run",
          "verify",
          "cleanup"
        ],
        "additionalProperties": false,
        "properties": {
          "feature_id": {
            "type": "string",
            "pattern": "^M[0-9]{2}-F[0-9]{2}$"
          },
          "prepare": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "argv"
              ],
              "additionalProperties": false,
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "executor": {
                  "enum": [
                    "local",
                    "ssh",
                    "container",
                    "kubernetes"
                  ]
                },
                "node": {
                  "type": "string",
                  "minLength": 1
                },
                "container": {
                  "type": "string",
                  "minLength": 1
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1
                },
                "case_id": {
                  "type": "string"
                },
                "optional": {
                  "type": "boolean"
                }
              }
            }
          },
          "run": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "argv"
              ],
              "additionalProperties": false,
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "executor": {
                  "enum": [
                    "local",
                    "ssh",
                    "container",
                    "kubernetes"
                  ]
                },
                "node": {
                  "type": "string",
                  "minLength": 1
                },
                "container": {
                  "type": "string",
                  "minLength": 1
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1
                },
                "case_id": {
                  "type": "string"
                },
                "optional": {
                  "type": "boolean"
                }
              }
            },
            "minItems": 1
          },
          "verify": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "argv"
              ],
              "additionalProperties": false,
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "executor": {
                  "enum": [
                    "local",
                    "ssh",
                    "container",
                    "kubernetes"
                  ]
                },
                "node": {
                  "type": "string",
                  "minLength": 1
                },
                "container": {
                  "type": "string",
                  "minLength": 1
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1
                },
                "case_id": {
                  "type": "string"
                },
                "optional": {
                  "type": "boolean"
                }
              }
            },
            "minItems": 1
          },
          "cleanup": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "argv"
              ],
              "additionalProperties": false,
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "executor": {
                  "enum": [
                    "local",
                    "ssh",
                    "container",
                    "kubernetes"
                  ]
                },
                "node": {
                  "type": "string",
                  "minLength": 1
                },
                "container": {
                  "type": "string",
                  "minLength": 1
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1
                },
                "case_id": {
                  "type": "string"
                },
                "optional": {
                  "type": "boolean"
                }
              }
            },
            "minItems": 1
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "name"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "node": {
                  "type": "string",
                  "minLength": 1
                },
                "namespace": {
                  "type": "string",
                  "minLength": 1
                },
                "uid": {
                  "type": "string",
                  "minLength": 1
                },
                "ownership_label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "observe": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "argv"
              ],
              "additionalProperties": false,
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "executor": {
                  "enum": [
                    "local",
                    "ssh",
                    "container",
                    "kubernetes"
                  ]
                },
                "node": {
                  "type": "string",
                  "minLength": 1
                },
                "container": {
                  "type": "string",
                  "minLength": 1
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1
                },
                "case_id": {
                  "type": "string"
                },
                "optional": {
                  "type": "boolean"
                }
              }
            }
          },
          "case_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "bindings_sha256": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "recipe_sources": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
