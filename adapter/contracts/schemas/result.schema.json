{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "identity",
    "feature_id",
    "feature_revision",
    "evidence_origin",
    "artifacts",
    "cases"
  ],
  "properties": {
    "identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "feature_id": {
      "type": "string"
    },
    "feature_revision": {
      "type": "integer",
      "minimum": 1
    },
    "evidence_origin": {
      "enum": [
        "current_run",
        "inherited",
        "historical"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "sha256",
          "role"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "assertions",
          "artifacts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "assertions": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "passed",
                "evidence"
              ],
              "properties": {
                "passed": {
                  "type": "boolean"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  }
}
