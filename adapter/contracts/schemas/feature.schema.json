{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "revision",
    "dependencies",
    "requirements",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^M[0-9]{2}-F[0-9]{2}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "enum": [
          "ssh",
          "workspace",
          "device",
          "runtime",
          "images",
          "models",
          "kubernetes",
          "multinode",
          "network"
        ]
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "required_assertions",
          "evidence_requirements"
        ],
        "properties": {
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "op",
                  "path"
                ],
                "properties": {
                  "op": {
                    "enum": [
                      "equal",
                      "positive",
                      "minimum",
                      "maximum",
                      "nonempty",
                      "equal_fields",
                      "different_fields",
                      "file_parity",
                      "unique_minimum",
                      "bounded_growth"
                    ]
                  },
                  "path": {
                    "type": "string"
                  },
                  "expected_from": {
                    "type": "string"
                  },
                  "other": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "dependencies_any_of": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      }
    }
  }
}
