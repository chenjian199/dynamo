{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "m09-offline-qwen32-tools",
    "namespace": "dynamo-m08-1029",
    "labels": {
      "heyi.io/campaign": "m09-1029"
    }
  },
  "spec": {
    "nodeSelector": {
      "kubernetes.io/arch": "arm64",
      "kubernetes.io/hostname": "master-02-45d4a763"
    },
    "containers": [
      {
        "name": "main",
        "image": "heyi/dynamo-profiler-ascend:1.5.1-m08-advanced",
        "imagePullPolicy": "Never",
        "command": [
          "/bin/bash",
          "-lc",
          "sleep 21600"
        ],
        "env": [
          {
            "name": "DYN_PLATFORM",
            "value": "cpu"
          },
          {
            "name": "TORCH_DEVICE_BACKEND_AUTOLOAD",
            "value": "0"
          },
          {
            "name": "PYTHONUNBUFFERED",
            "value": "1"
          },
          {
            "name": "PYTHONPATH",
            "value": "/m09-deps:/m09-source/components/src:/opt/dynamo/profiler-support"
          },
          {
            "name": "K3S_DATA_DIR",
            "value": "/tmp/m09-k3s"
          }
        ],
        "resources": {
          "requests": {
            "cpu": "1",
            "memory": "2Gi"
          },
          "limits": {
            "cpu": "4",
            "memory": "8Gi"
          }
        },
        "volumeMounts": [
          {
            "name": "m09-source",
            "mountPath": "/m09-source",
            "readOnly": true
          },
          {
            "name": "offline-work",
            "mountPath": "/offline"
          },
          {
            "name": "models",
            "mountPath": "/models/current",
            "readOnly": true
          },
          {
            "name": "m09-deps",
            "mountPath": "/m09-deps",
            "readOnly": true
          },
          {
            "name": "profiler-tokenizer",
            "mountPath": "/opt/dynamo/venv/lib/python3.12/site-packages/aiperf/common/tokenizer.py",
            "subPath": "tokenizer.py",
            "readOnly": true
          },
          {
            "name": "deployment-client",
            "mountPath": "/opt/dynamo/profiler-support/deploy/utils/dynamo_deployment.py",
            "subPath": "dynamo_deployment.py",
            "readOnly": true
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "m09-source",
        "hostPath": {
          "path": "/root/CJ_workspace/m09-offline-qwen32-1030/source",
          "type": "Directory"
        }
      },
      {
        "name": "offline-work",
        "hostPath": {
          "path": "/root/CJ_workspace/m09-offline-qwen32-1030",
          "type": "Directory"
        }
      },
      {
        "name": "models",
        "hostPath": {
          "path": "/data/Qwen3-32B",
          "type": "Directory"
        }
      },
      {
        "name": "m09-deps",
        "hostPath": {
          "path": "/root/CJ_workspace/m09-offline-qwen32-1030/deps",
          "type": "Directory"
        }
      },
      {
        "name": "profiler-tokenizer",
        "configMap": {
          "name": "m08-profiler-source"
        }
      },
      {
        "name": "deployment-client",
        "configMap": {
          "name": "m08-profiler-source"
        }
      }
    ],
    "restartPolicy": "Never",
    "activeDeadlineSeconds": 21600,
    "securityContext": {
      "runAsUser": 0,
      "runAsGroup": 0
    },
    "serviceAccountName": "m09-offline-tools"
  }
}
