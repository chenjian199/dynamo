              "path": "/execution_image",
              "expected_from": "/case_binding/image"
            },
            {
              "op": "equal",
              "path": "/observed_topology",
              "expected_from": "/case_binding/topology"
            },
            {
              "op": "equal",
              "path": "/model_manifests",
              "expected_from": "/model_manifests"
            }
          ],
          "native_reference": [
            {
              "op": "equal_fields",
              "path": "/dynamo/output_tokens",
              "other": "/native/output_tokens",
              "nonempty": true
            }
          ],
          "dynamo_output_valid": [
            {
              "op": "equal_fields",
              "path": "/dynamo/output_tokens",
              "other": "/native/output_tokens",
              "nonempty": true
            }
          ]
        },
