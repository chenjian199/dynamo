        },
        "negative_cases": [
          "missing_or_modified_measurement",
          "wrong_image_or_model_identity",
          "native_failure_kept_separate"
        ],
        "native_control": "Same model revision, engine parameters, workload and topology; paired raw outputs required where parity is asserted."
      }
