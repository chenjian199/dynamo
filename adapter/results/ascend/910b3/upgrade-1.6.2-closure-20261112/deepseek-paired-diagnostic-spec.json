{
  "container_model": "/models/DeepSeek-V4-Flash-w8a8-mtp",
  "topology": {
    "tp": 8,
    "dp": 1,
    "pp": 1,
    "ep": 8
  },
  "startup_timeout": 1500,
  "engine_args": [
    "--enable-expert-parallel",
    "--tokenizer-mode",
    "deepseek_v4",
    "--quantization",
    "ascend",
    "--max-num-batched-tokens",
    "4096",
    "--additional-config",
    "{\"enable_dsa_cp\":true}",
    "--no-enable-prefix-caching"
  ]
}
