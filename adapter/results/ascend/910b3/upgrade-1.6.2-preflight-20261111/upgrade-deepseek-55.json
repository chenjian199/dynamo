{
  "apiVersion": "nvidia.com/v1beta1",
  "kind": "DynamoGraphDeployment",
  "metadata": {
    "name": "upgrade-deepseek-55",
    "namespace": "heyi-upgrade162",
    "annotations": {
      "nvidia.com/workload-provider": "component",
      "nvidia.com/enable-grove": "false",
      "nvidia.com/dynamo-discovery-backend": "kubernetes"
    },
    "labels": {
      "heyi.io/campaign": "upgrade-1.6.2-ascend-20261111"
    }
  },
  "spec": {
    "backendFramework": "vllm",
    "components": [
      {
        "name": "frontend",
        "type": "frontend",
        "replicas": 1,
        "runtimeVersionOverride": "1.6.2",
        "sharedMemorySize": "8Gi",
        "podTemplate": {
          "spec": {
            "nodeSelector": {
              "kubernetes.io/arch": "arm64",
              "kubernetes.io/hostname": "master"
            },
            "containers": [
              {
                "name": "main",
                "image": "heyi/dynamo:1.6.2-ascend0.30-49ef509336-runtime",
                "imagePullPolicy": "Never",
                "command": [
                  "/opt/dynamo/bin/entrypoint.sh"
                ],
                "args": [
                  "python",
                  "-m",
                  "dynamo.frontend",
                  "--router-mode",
                  "kv"
                ],
                "env": [
                  {
                    "name": "HF_HUB_OFFLINE",
                    "value": "1"
                  },
                  {
                    "name": "DYN_REQUEST_PLANE",
                    "value": "tcp"
                  },
                  {
                    "name": "DYN_EVENT_PLANE",
                    "value": "zmq"
                  },
                  {
                    "name": "DYN_ROUTER_USE_KV_EVENTS",
                    "value": "true"
                  },
                  {
                    "name": "DYN_PLATFORM",
                    "value": "cpu"
                  },
                  {
                    "name": "OMP_NUM_THREADS",
                    "value": "4"
                  },
                  {
                    "name": "PYTHONUNBUFFERED",
                    "value": "1"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "1",
                    "memory": "2Gi"
                  },
                  "limits": {
                    "memory": "32Gi",
                    "cpu": "8"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "models",
                    "mountPath": "/models/DeepSeek-V4-Flash-w8a8-mtp",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "models",
                "hostPath": {
                  "path": "/data/DeepSeek-V4-Flash-w8a8-mtp",
                  "type": "Directory"
                }
              }
            ]
          }
        }
      },
      {
        "name": "worker",
        "type": "worker",
        "replicas": 1,
        "runtimeVersionOverride": "1.6.2",
        "sharedMemorySize": "32Gi",
        "podTemplate": {
          "spec": {
            "nodeSelector": {
              "kubernetes.io/arch": "arm64",
              "kubernetes.io/hostname": "master"
            },
            "containers": [
              {
                "name": "main",
                "image": "heyi/dynamo:1.6.2-ascend0.30-49ef509336-runtime",
                "imagePullPolicy": "Never",
                "command": [
                  "/opt/dynamo/bin/entrypoint.sh"
                ],
                "args": [
                  "python",
                  "-m",
                  "dynamo.vllm",
                  "--model",
                  "/models/DeepSeek-V4-Flash-w8a8-mtp",
                  "--served-model-name",
                  "upgrade-deepseek",
                  "--tensor-parallel-size",
                  "8",
                  "--enable-expert-parallel",
                  "--enforce-eager",
                  "--max-model-len",
                  "4096",
                  "--max-num-batched-tokens",
                  "4096",
                  "--max-num-seqs",
                  "4",
                  "--gpu-memory-utilization",
                  "0.9",
                  "--block-size",
                  "128",
                  "--tokenizer-mode",
                  "deepseek_v4",
                  "--quantization",
                  "ascend",
                  "--no-enable-prefix-caching",
                  "--additional-config",
                  "{\"enable_dsa_cp\":true}"
                ],
                "env": [
                  {
                    "name": "HF_HUB_OFFLINE",
                    "value": "1"
                  },
                  {
                    "name": "DYN_REQUEST_PLANE",
                    "value": "tcp"
                  },
                  {
                    "name": "DYN_EVENT_PLANE",
                    "value": "zmq"
                  },
                  {
                    "name": "DYN_ROUTER_USE_KV_EVENTS",
                    "value": "true"
                  },
                  {
                    "name": "DYN_PLATFORM",
                    "value": "ascend"
                  },
                  {
                    "name": "VLLM_HOST_IP",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "status.podIP"
                      }
                    }
                  },
                  {
                    "name": "VLLM_MOONCAKE_BOOTSTRAP_PORT",
                    "value": "20090"
                  },
                  {
                    "name": "VLLM_MOONCAKE_ABORT_REQUEST_TIMEOUT",
                    "value": "60"
                  },
                  {
                    "name": "ASCEND_TRANSFER_TIMEOUT",
                    "value": "30000"
                  },
                  {
                    "name": "PYTHONUNBUFFERED",
                    "value": "1"
                  },
                  {
                    "name": "OMP_NUM_THREADS",
                    "value": "4"
                  },
                  {
                    "name": "OMP_PROC_BIND",
                    "value": "false"
                  },
                  {
                    "name": "PYTORCH_NPU_ALLOC_CONF",
                    "value": "expandable_segments:True"
                  },
                  {
                    "name": "HCCL_BUFFSIZE",
                    "value": "1024"
                  },
                  {
                    "name": "TASK_QUEUE_ENABLE",
                    "value": "1"
                  },
                  {
                    "name": "HCCL_OP_EXPANSION_MODE",
                    "value": "AIV"
                  },
                  {
                    "name": "HCCL_CONNECT_TIMEOUT",
                    "value": "300"
                  },
                  {
                    "name": "HCCL_EXEC_TIMEOUT",
                    "value": "300"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "32",
                    "memory": "128Gi",
                    "huawei.com/Ascend910": "8"
                  },
                  "limits": {
                    "cpu": "64",
                    "memory": "384Gi",
                    "huawei.com/Ascend910": "8"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "models",
                    "mountPath": "/models/DeepSeek-V4-Flash-w8a8-mtp",
                    "readOnly": true
                  },
                  {
                    "name": "ascend-driver",
                    "mountPath": "/usr/local/Ascend/driver",
                    "readOnly": true
                  },
                  {
                    "name": "ascend-dcmi",
                    "mountPath": "/usr/local/dcmi",
                    "readOnly": true
                  },
                  {
                    "name": "ascend-smi",
                    "mountPath": "/usr/local/sbin/npu-smi",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "models",
                "hostPath": {
                  "path": "/data/DeepSeek-V4-Flash-w8a8-mtp",
                  "type": "Directory"
                }
              },
              {
                "name": "ascend-driver",
                "hostPath": {
                  "path": "/usr/local/Ascend/driver",
                  "type": "Directory"
                }
              },
              {
                "name": "ascend-dcmi",
                "hostPath": {
                  "path": "/usr/local/dcmi",
                  "type": "Directory"
                }
              },
              {
                "name": "ascend-smi",
                "hostPath": {
                  "path": "/usr/local/sbin/npu-smi",
                  "type": "File"
                }
              }
            ],
            "tolerations": [
              {
                "key": "huawei.com/Ascend910",
                "operator": "Exists",
                "effect": "NoSchedule"
              }
            ]
          }
        }
      }
    ]
  }
}
