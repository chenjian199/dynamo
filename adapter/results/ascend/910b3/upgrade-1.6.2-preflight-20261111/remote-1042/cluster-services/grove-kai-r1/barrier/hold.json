{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "upgrade-grove-kai-capacity-hold",
    "namespace": "heyi-upgrade162"
  },
  "spec": {
    "nodeSelector": {
      "kubernetes.io/arch": "arm64",
      "kubernetes.io/hostname": "master"
    },
    "restartPolicy": "Never",
    "activeDeadlineSeconds": 900,
    "containers": [
      {
        "name": "hold",
        "image": "heyi/dynamo:1.6.2-ascend0.30-49ef509336-runtime",
        "imagePullPolicy": "Never",
        "command": [
          "/bin/sh",
          "-c",
          "sleep 900"
        ],
        "resources": {
          "limits": {
            "huawei.com/Ascend910": 7
          }
        }
      }
    ]
  }
}