{
  "apiVersion": "nvidia.com/v1beta1",
  "kind": "DynamoGraphDeployment",
  "metadata": {
    "name": "upgrade-pp2-new",
    "namespace": "heyi-upgrade162",
    "labels": {
      "heyi.io/campaign": "upgrade-1.6.2-ascend-20261111"
    },
    "annotations": {
      "nvidia.com/workload-provider": "component",
      "nvidia.com/enable-grove": "false",
      "nvidia.com/dynamo-discovery-backend": "kubernetes"
    }
  },
  "spec": {
    "backendFramework": "vllm",
    "components": [
      {
        "name": "frontend",
        "type": "frontend",
        "replicas": 1,
        "runtimeVersionOverride": "1.6.2",
        "sharedMemorySize": "8Gi",
        "podTemplate": {
          "spec": {
            "nodeSelector": {
              "kubernetes.io/hostname": "master",
              "kubernetes.io/arch": "arm64"
            },
            "containers": [
              {
                "name": "main",
                "image": "heyi/dynamo:1.6.2-ascend0.30-1aabe435ad-runtime",
                "imagePullPolicy": "Never",
                "command": [
                  "/opt/dynamo/bin/entrypoint.sh"
                ],
                "args": [
                  "python",
                  "-m",
                  "dynamo.frontend",
                  "--router-mode",
                  "round-robin"
                ],
                "env": [
                  {
                    "name": "HF_HUB_OFFLINE",
                    "value": "1"
                  },
                  {
                    "name": "DYN_REQUEST_PLANE",
                    "value": "tcp"
                  },
                  {
                    "name": "DYN_EVENT_PLANE",
                    "value": "zmq"
                  },
                  {
                    "name": "DYN_PLATFORM",
                    "value": "cpu"
                  },
                  {
                    "name": "PYTHONUNBUFFERED",
                    "value": "1"
                  },
                  {
                    "name": "GOMAXPROCS",
                    "value": "4"
                  },
                  {
                    "name": "SPT_NOENV",
                    "value": "1"
                  },
                  {
                    "name": "OMP_NUM_THREADS",
                    "value": "4"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "1",
                    "memory": "2Gi"
                  },
                  "limits": {
                    "memory": "32Gi",
                    "cpu": "8"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "models",
                    "mountPath": "/models/Qwen3-0.6B",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "models",
                "hostPath": {
                  "path": "/data/dynamo-regression-models/Qwen3-0.6B",
                  "type": "Directory"
                }
              }
            ],
            "terminationGracePeriodSeconds": 90
          }
        }
      },
      {
        "name": "worker",
        "type": "worker",
        "replicas": 1,
        "runtimeVersionOverride": "1.6.2",
        "sharedMemorySize": "8Gi",
        "podTemplate": {
          "spec": {
            "nodeSelector": {
              "kubernetes.io/hostname": "master",
              "kubernetes.io/arch": "arm64"
            },
            "containers": [
              {
                "name": "main",
                "image": "heyi/dynamo:1.6.2-ascend0.30-1aabe435ad-runtime",
                "imagePullPolicy": "Never",
                "command": [
                  "/opt/dynamo/bin/entrypoint.sh"
                ],
                "args": [
                  "python",
                  "-m",
                  "dynamo.vllm",
                  "--model",
                  "/models/Qwen3-0.6B",
                  "--served-model-name",
                  "upgrade-compare",
                  "--tensor-parallel-size",
                  "1",
                  "--dtype",
                  "bfloat16",
                  "--enforce-eager",
                  "--disable-custom-all-reduce",
                  "--no-enable-prefix-caching",
                  "--max-model-len",
                  "2048",
                  "--max-num-seqs",
                  "8",
                  "--max-num-batched-tokens",
                  "2048",
                  "--kv-cache-memory-bytes",
                  "536870912",
                  "--gpu-memory-utilization",
                  "0.2",
                  "--block-size",
                  "128",
                  "--pipeline-parallel-size",
                  "2"
                ],
                "env": [
                  {
                    "name": "HF_HUB_OFFLINE",
                    "value": "1"
                  },
                  {
                    "name": "DYN_REQUEST_PLANE",
                    "value": "tcp"
                  },
                  {
                    "name": "DYN_EVENT_PLANE",
                    "value": "zmq"
                  },
                  {
                    "name": "DYN_PLATFORM",
                    "value": "ascend"
                  },
                  {
                    "name": "VLLM_HOST_IP",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "status.podIP"
                      }
                    }
                  },
                  {
                    "name": "VLLM_MOONCAKE_BOOTSTRAP_PORT",
                    "value": "20090"
                  },
                  {
                    "name": "VLLM_MOONCAKE_ABORT_REQUEST_TIMEOUT",
                    "value": "60"
                  },
                  {
                    "name": "ASCEND_TRANSFER_TIMEOUT",
                    "value": "30000"
                  },
                  {
                    "name": "PYTHONUNBUFFERED",
                    "value": "1"
                  },
                  {
                    "name": "GOMAXPROCS",
                    "value": "4"
                  },
                  {
                    "name": "SPT_NOENV",
                    "value": "1"
                  },
                  {
                    "name": "OMP_NUM_THREADS",
                    "value": "4"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "4",
                    "memory": "16Gi",
                    "huawei.com/Ascend910": "2"
                  },
                  "limits": {
                    "cpu": "16",
                    "memory": "64Gi",
                    "huawei.com/Ascend910": "2"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "models",
                    "mountPath": "/models/Qwen3-0.6B",
                    "readOnly": true
                  },
                  {
                    "name": "ascend-driver",
                    "mountPath": "/usr/local/Ascend/driver",
                    "readOnly": true
                  },
                  {
                    "name": "ascend-dcmi",
                    "mountPath": "/usr/local/dcmi",
                    "readOnly": true
                  },
                  {
                    "name": "ascend-smi",
                    "mountPath": "/usr/local/sbin/npu-smi",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "models",
                "hostPath": {
                  "path": "/data/dynamo-regression-models/Qwen3-0.6B",
                  "type": "Directory"
                }
              },
              {
                "name": "ascend-driver",
                "hostPath": {
                  "path": "/usr/local/Ascend/driver",
                  "type": "Directory"
                }
              },
              {
                "name": "ascend-dcmi",
                "hostPath": {
                  "path": "/usr/local/dcmi",
                  "type": "Directory"
                }
              },
              {
                "name": "ascend-smi",
                "hostPath": {
                  "path": "/usr/local/bin/npu-smi",
                  "type": "File"
                }
              }
            ],
            "tolerations": [
              {
                "key": "huawei.com/Ascend910",
                "operator": "Exists",
                "effect": "NoSchedule"
              }
            ],
            "terminationGracePeriodSeconds": 90
          }
        }
      }
    ]
  }
}
