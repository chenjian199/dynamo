{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "upgrade-pd-soak-final-r1",
    "namespace": "heyi-upgrade162"
  },
  "spec": {
    "nodeSelector": {
      "kubernetes.io/hostname": "master",
      "kubernetes.io/arch": "arm64"
    },
    "containers": [
      {
        "name": "main",
        "image": "heyi/dynamo:1.6.2-ascend0.30-1aabe435ad-runtime",
        "imagePullPolicy": "Never",
        "command": [
          "/opt/dynamo/bin/entrypoint.sh"
        ],
        "args": [
          "bash",
          "-ec",
          "python /harness/check-installed.py --role runtime > /evidence/installed.json; python /harness/adapter/modules/m05-pd-transfer/common/transfer/run.py --platform ascend --model /models/Qwen3-0.6B --devices 0,1 --cancel --handoff-case unreachable --soak-seconds 1800 --soak-requests 1000 --output /evidence/results"
        ],
        "env": [
          {
            "name": "HF_HUB_OFFLINE",
            "value": "1"
          },
          {
            "name": "VLLM_HOST_IP",
            "valueFrom": {
              "fieldRef": {
                "fieldPath": "status.podIP"
              }
            }
          },
          {
            "name": "VLLM_MOONCAKE_BOOTSTRAP_PORT",
            "value": "20090"
          },
          {
            "name": "VLLM_MOONCAKE_ABORT_REQUEST_TIMEOUT",
            "value": "60"
          },
          {
            "name": "ASCEND_TRANSFER_TIMEOUT",
            "value": "30000"
          },
          {
            "name": "PYTHONUNBUFFERED",
            "value": "1"
          },
          {
            "name": "GOMAXPROCS",
            "value": "4"
          },
          {
            "name": "SPT_NOENV",
            "value": "1"
          },
          {
            "name": "OMP_NUM_THREADS",
            "value": "4"
          },
          {
            "name": "DYN_PLATFORM",
            "value": "ascend"
          },
          {
            "name": "PYTORCH_NPU_ALLOC_CONF",
            "value": "expandable_segments:True"
          },
          {
            "name": "DYNAMO_RELEASE_SOURCE_COMMIT",
            "value": "1aabe435ad56922cf7e12f92f64df2dc39531ccb"
          }
        ],
        "resources": {
          "requests": {
            "cpu": "4",
            "memory": "16Gi",
            "huawei.com/Ascend910": "2"
          },
          "limits": {
            "cpu": "16",
            "memory": "96Gi",
            "huawei.com/Ascend910": "2"
          }
        },
        "volumeMounts": [
          {
            "name": "models",
            "mountPath": "/models/Qwen3-0.6B",
            "readOnly": true
          },
          {
            "name": "ascend-driver",
            "mountPath": "/usr/local/Ascend/driver",
            "readOnly": true
          },
          {
            "name": "ascend-dcmi",
            "mountPath": "/usr/local/dcmi",
            "readOnly": true
          },
          {
            "name": "ascend-smi",
            "mountPath": "/usr/local/sbin/npu-smi",
            "readOnly": true
          },
          {
            "name": "shm",
            "mountPath": "/dev/shm"
          },
          {
            "name": "harness",
            "mountPath": "/harness",
            "readOnly": true
          },
          {
            "name": "evidence",
            "mountPath": "/evidence",
            "readOnly": false
          }
        ],
        "workingDir": "/harness"
      }
    ],
    "volumes": [
      {
        "name": "models",
        "hostPath": {
          "path": "/data/dynamo-regression-models/Qwen3-0.6B",
          "type": "Directory"
        }
      },
      {
        "name": "ascend-driver",
        "hostPath": {
          "path": "/usr/local/Ascend/driver",
          "type": "Directory"
        }
      },
      {
        "name": "ascend-dcmi",
        "hostPath": {
          "path": "/usr/local/dcmi",
          "type": "Directory"
        }
      },
      {
        "name": "ascend-smi",
        "hostPath": {
          "path": "/usr/local/bin/npu-smi",
          "type": "File"
        }
      },
      {
        "name": "shm",
        "emptyDir": {
          "medium": "Memory",
          "sizeLimit": "8Gi"
        }
      },
      {
        "name": "harness",
        "hostPath": {
          "path": "/data/dynamo-upgrade-1.6.2-20261111/candidate-1aabe/full-harness",
          "type": "Directory"
        }
      },
      {
        "name": "evidence",
        "hostPath": {
          "path": "/data/dynamo-upgrade-1.6.2-20261111/candidate-1aabe/pd-soak-final-r1",
          "type": "DirectoryOrCreate"
        }
      }
    ],
    "tolerations": [
      {
        "key": "huawei.com/Ascend910",
        "operator": "Exists",
        "effect": "NoSchedule"
      }
    ],
    "terminationGracePeriodSeconds": 90,
    "restartPolicy": "Never",
    "activeDeadlineSeconds": 3600,
    "automountServiceAccountToken": false
  }
}
