{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "m10-tools",
    "namespace": "heyi-upgrade162",
    "labels": {
      "heyi.io/campaign": "heyi-upgrade162"
    }
  },
  "spec": {
    "nodeSelector": {
      "kubernetes.io/arch": "arm64",
      "kubernetes.io/hostname": "master-02-45d4a763"
    },
    "containers": [
      {
        "name": "main",
        "image": "heyi/dynamo:1.6.2-ascend0.30-49ef509336-tools",
        "imagePullPolicy": "Never",
        "command": [
          "/bin/bash",
          "-c",
          "sleep 21600"
        ],
        "env": [
          {
            "name": "DYN_PLATFORM",
            "value": "cpu"
          },
          {
            "name": "TORCH_DEVICE_BACKEND_AUTOLOAD",
            "value": "0"
          },
          {
            "name": "PYTHONUNBUFFERED",
            "value": "1"
          }
        ],
        "resources": {
          "requests": {
            "cpu": "1",
            "memory": "2Gi"
          },
          "limits": {
            "cpu": "4",
            "memory": "8Gi"
          }
        },
        "volumeMounts": []
      }
    ],
    "volumes": [],
    "restartPolicy": "Never",
    "activeDeadlineSeconds": 21600,
    "securityContext": {
      "runAsUser": 0,
      "runAsGroup": 0
    }
  }
}
