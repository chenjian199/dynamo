{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "upgrade-comparison-tools",
    "namespace": "heyi-upgrade162",
    "labels": {
      "heyi.io/campaign": "upgrade-1.6.2-ascend-20261111"
    }
  },
  "spec": {
    "nodeSelector": {
      "kubernetes.io/hostname": "master-02-45d4a763"
    },
    "restartPolicy": "Never",
    "activeDeadlineSeconds": 7200,
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "main",
        "image": "heyi/dynamo:1.6.2-ascend0.30-49ef509336-tools",
        "imagePullPolicy": "Never",
        "command": [
          "/opt/dynamo/bin/tools-entrypoint.sh"
        ],
        "args": [
          "sleep",
          "infinity"
        ],
        "env": [
          {
            "name": "DYN_PLATFORM",
            "value": "cpu"
          },
          {
            "name": "TORCH_DEVICE_BACKEND_AUTOLOAD",
            "value": "0"
          }
        ],
        "resources": {
          "requests": {
            "cpu": "1",
            "memory": "2Gi"
          },
          "limits": {
            "cpu": "4",
            "memory": "8Gi"
          }
        },
        "volumeMounts": [
          {
            "name": "comparison",
            "mountPath": "/comparison"
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "comparison",
        "hostPath": {
          "path": "/data/dynamo-upgrade-1.6.2-20261111/comparison-r1",
          "type": "Directory"
        }
      }
    ]
  }
}
