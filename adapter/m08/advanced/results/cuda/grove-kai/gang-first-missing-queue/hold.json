{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "m08-grove-kai-capacity-hold",
    "namespace": "dynamo-m08-1029"
  },
  "spec": {
    "nodeSelector": {
      "kubernetes.io/arch": "amd64",
      "kubernetes.io/hostname": "worker06"
    },
    "restartPolicy": "Never",
    "activeDeadlineSeconds": 900,
    "containers": [
      {
        "name": "hold",
        "image": "heyi/dynamo-vllm-cuda-runtime:1.5.1-m02",
        "imagePullPolicy": "Never",
        "command": [
          "/bin/sh",
          "-c",
          "sleep 900"
        ],
        "resources": {
          "limits": {
            "nvidia.com/gpu": 7
          }
        }
      }
    ],
    "runtimeClassName": "nvidia"
  }
}