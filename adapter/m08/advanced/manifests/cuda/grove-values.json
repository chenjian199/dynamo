{
  "image": {
    "repository": "ghcr.io/ai-dynamo/grove/grove-operator",
    "tag": "v0.1.0-alpha.13",
    "pullPolicy": "Never"
  },
  "nodeSelector": {
    "kubernetes.io/hostname": "worker06"
  },
  "config": {
    "scheduler": {
      "profiles": [
        {
          "name": "default-scheduler"
        }
      ]
    },
    "topologyAwareScheduling": {
      "enabled": false
    }
  },
  "deployment": {
    "env": [
      {
        "name": "GROVE_INIT_CONTAINER_IMAGE",
        "value": "ghcr.io/ai-dynamo/grove/grove-initc:v0.1.0-alpha.13"
      }
    ]
  },
  "crdInstaller": {
    "enabled": false
  }
}
